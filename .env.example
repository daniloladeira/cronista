# Copie para .env e preencha. O .env NUNCA vai para o controle de versão.
#   cp .env.example .env

# ─── Banco ────────────────────────────────────────────────────────────────
POSTGRES_USER=meet
POSTGRES_PASSWORD=
POSTGRES_DB=meet_transcript
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://meet:SENHA@localhost:5432/meet_transcript

# ─── Autenticação ─────────────────────────────────────────────────────────
# Usuário único — ver docs/adr/0011-jwt-usuario-unico.md
# AUTH_PASSWORD_HASH recebe um hash Argon2, NUNCA a senha em texto claro.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Segredo de assinatura do JWT. Gerar aleatório e longo; trocá-lo invalida todos os tokens.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ─── Armazenamento ────────────────────────────────────────────────────────
# Raiz do acervo de áudio. Os caminhos no banco são relativos a ela,
# então mover o acervo não exige tocar no banco (ADR-0004).
DATA_ROOT=
# Retenção de áudio — nunca afeta transcrição nem resumos (RN-04)
KEEP_AUDIO_DAYS=30
AUDIO_POLICY=compress

# ─── Transcrição ──────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=pt
# Segundos de ociosidade antes de descarregar o modelo da VRAM (ADR-0014).
# Whisper e o modelo de resumo nao cabem juntos em 8 GB.
WHISPER_IDLE_UNLOAD_SECONDS=300
# Vocabulário de domínio: nomes próprios e termos técnicos, separados por vírgula.
# É o diferencial do projeto em pt-BR (RF-13) — ver docs/12-transcricao.md
WHISPER_VOCABULARY=

# ─── Resumo ───────────────────────────────────────────────────────────────
# ollama (padrão, local, sem custo) ou anthropic (remoto, melhor qualidade)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Modelo a definir por teste em português real — ver docs/15-roadmap.md §4
OLLAMA_MODEL=
# Só necessário se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ─── API ──────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1
