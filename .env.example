# ─── Banco ────────────────────────────────────────────────────────────────
POSTGRES_USER=cronista
POSTGRES_PASSWORD=
POSTGRES_DB=cronista
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cronista:SENHA@localhost:5432/cronista

# ─── Autenticação ─────────────────────────────────────────────────────────
# Usuário único, ver docs/adr/0011-jwt-usuario-unico.md
# AUTH_PASSWORD_HASH recebe um hash Argon2, NUNCA a senha em texto claro.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Segredo de assinatura do JWT. Gerar aleatório e longo; trocá-lo invalida todos os tokens.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ─── Armazenamento ────────────────────────────────────────────────────────
# Raiz do acervo de áudio. Os caminhos no banco são relativos a ela,
# então mover o acervo não exige tocar no banco (ADR-0004).
# OBRIGATÓRIO — cliente e API leem a MESMA raiz, mesma máquina (docs/09-api.md §1).
# Ex.: C:\Users\SEU_USUARIO\AppData\Local\cronista
DATA_ROOT=
# Retenção de áudio, nunca afeta transcrição nem resumos (RN-04)
KEEP_AUDIO_DAYS=30
AUDIO_POLICY=compress

# ─── Transcrição ──────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=pt
# Segundos de ociosidade antes de descarregar o modelo da VRAM (ADR-0014).
# Whisper e o modelo de resumo nao cabem juntos em 8 GB.
WHISPER_IDLE_UNLOAD_SECONDS=300
# Vocabulário de domínio: nomes próprios e termos técnicos, separados por vírgula.
# É o diferencial do projeto em pt-BR (RF-13), ver docs/12-transcricao.md
WHISPER_VOCABULARY=
# Quantização de segunda tentativa se faltar memória de GPU (docs/12 §9).
# Nunca troca de modelo, só de quantização.
WHISPER_FALLBACK_COMPUTE_TYPE=int8

# ─── Worker de transcrição ────────────────────────────────────────────────
# Intervalo entre consultas à fila (meetings.status) quando ela está vazia.
WORKER_POLL_INTERVAL_SECONDS=5
# Resumo automático pós-transcrição (docs/07-arquitetura.md §3-4.3).
# Desligado por padrão -- precisa dos três abaixo pra ligar de verdade.
WORKER_AUTO_SUMMARIZE=false
# Docker Desktop resolve isso pro host Windows sem config extra (medido).
WORKER_API_BASE_URL=http://host.docker.internal:8000/api/v1
# Token de serviço de vida longa, não é login de usuário nem expira em
# minutos como o token de sessão normal. Gerar com:
#   python scripts/mint_worker_token.py
WORKER_SERVICE_TOKEN=

# ─── Resumo ───────────────────────────────────────────────────────────────
# ollama (padrão, local, sem custo) ou anthropic (remoto, melhor qualidade)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Modelo a definir por teste em português real, ver docs/15-roadmap.md §4
OLLAMA_MODEL=
# Janela de contexto -- 8192 medido contra RTX 4060 8GB (docs/13 §5).
# Ajustar pra baixo se a GPU não tiver VRAM sobrando.
OLLAMA_NUM_CTX=8192
# Só necessário se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ─── API ──────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1
